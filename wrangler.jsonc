{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "name": "myipv4v6",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "IP_CACHE",
      "id": "167b4a4e50a645b5866d967541dd12ec"
    },
    {
      "binding": "SESSION",
      "id": "312a7fbb0b784f3791459fe52a1c18f5"
    }
  ],
  "observability": {
    "enabled": true
  }
}