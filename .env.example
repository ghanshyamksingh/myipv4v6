# -------------------------------------------------------------
# myipv4v6.com - Environment Variables Configuration
# -------------------------------------------------------------

# Sanity CMS Configuration
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here
PUBLIC_SANITY_DATASET=production

# Base Canonical Site URL
PUBLIC_SITE_URL=https://myipv4v6.com

# External Geolocation Provider Configuration
# Options: 'ipwhois' (free, HTTPS default), 'ipinfo', or 'ip-api'
IP_PROVIDER=ipwhois

# Optional: IPInfo.io Access Token (if IP_PROVIDER=ipinfo)
# IPINFO_TOKEN=your_ipinfo_token_here

# Optional: Pro IP-API Key (if IP_PROVIDER=ip-api and using https://pro.ip-api.com)
# IP_API_KEY=your_key_here

# Cloudflare KV Cache Binding Name (Configured in wrangler.jsonc)
# KV Binding: IP_CACHE
