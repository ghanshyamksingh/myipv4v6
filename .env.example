# -------------------------------------------------------------
# myipv4v6.com - Environment Variables Configuration
# -------------------------------------------------------------

# Sanity CMS Configuration
# Get your project ID from https://manage.sanity.io
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here
PUBLIC_SANITY_DATASET=production

# Base Canonical Site URL
PUBLIC_SITE_URL=https://myipv4v6.com

# External Geolocation Provider Configuration
# Supported providers:
# 1. 'ipwhois' (DEFAULT, 100% Free HTTPS endpoint at https://ipwho.is, no token required)
# 2. 'ipinfo'  (Requires IPINFO_TOKEN for standard HTTPS API queries)
# 3. 'ip-api'  (Requires IP_API_KEY for HTTPS pro.ip-api.com queries; note that free ip-api.com does not support HTTPS)
IP_PROVIDER=ipwhois

# Optional: IPInfo.io Access Token (Required if IP_PROVIDER=ipinfo)
# IPINFO_TOKEN=your_ipinfo_token_here

# Optional: Pro IP-API Key (Required if IP_PROVIDER=ip-api for HTTPS pro queries)
# IP_API_KEY=your_ip_api_pro_key_here

# Cloudflare KV Cache & Rate Limiting Binding
# Bound in wrangler.jsonc as IP_CACHE.
# Used for 24-hour enrichment caching and 60 req/min rate limiting.
# KV Binding: IP_CACHE
