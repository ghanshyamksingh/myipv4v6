---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getBlogPosts } from '../../utils/sanity';

const posts = await getBlogPosts();

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const pageTitle = 'Network Intelligence & Privacy Blog | myipv4v6.com';
const pageDescription = 'Technical articles, guides, and insights on IPv4 exhaustion, IPv6 adoption, BGP routing, Autonomous Systems, and digital privacy.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://myipv4v6.com/blog"
>
  <div class="max-w-4xl mx-auto w-full flex flex-col gap-10">
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Page Header -->
    <div class="flex flex-col gap-4 border-b border-neutral-200/80 dark:border-neutral-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/70 dark:text-blue-300 w-fit">
        Engineering & Network Insights
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-neutral-950 dark:text-white">
        Network Intelligence Blog
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Deep dives into internet protocols, Border Gateway Protocol (BGP) routing, IP address privacy, and edge architecture.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => {
        const formattedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });

        return (
          <article class="flex flex-col justify-between p-6 sm:p-7 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 shadow-xs hover:shadow-md hover:border-blue-500/40 dark:hover:border-blue-500/40 transition-all group">
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
                <span>{formattedDate}</span>
                {post.readTimeMinutes && (
                  <span>{post.readTimeMinutes} min read</span>
                )}
              </div>

              <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                <a href={`/blog/${post.slug.current}`}>
                  {post.title}
                </a>
              </h2>

              {post.excerpt && (
                <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>
              )}
            </div>

            <div class="pt-5 mt-4 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between">
              <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
                {post.author?.name || 'myipv4v6 Team'}
              </span>
              <a
                href={`/blog/${post.slug.current}`}
                class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 group-hover:underline"
              >
                <span>Read Article</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>
