---
import CopyButton from './CopyButton.astro';

interface Props {
  ip: string;
}

const { ip } = Astro.props;

const tools = [
  {
    name: 'Ping Test',
    command: `ping -c 4 ${ip}`,
    desc: 'Measure latency and round-trip time',
  },
  {
    name: 'Traceroute',
    command: `traceroute ${ip}`,
    desc: 'Trace autonomous system hops to destination',
  },
  {
    name: 'Reverse DNS (dig)',
    command: `dig -x ${ip} +short`,
    desc: 'Query PTR records for registered hostname',
  },
  {
    name: 'cURL API (myipv4v6)',
    command: `curl -s https://myipv4v6.com/api/ip?q=${ip}`,
    desc: 'Fetch JSON network details directly in terminal',
  },
];
---

<div class="rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 p-6 shadow-sm">
  <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-neutral-800 mb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-neutral-900 dark:text-white">Terminal Network Diagnostics</h3>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">Run diagnostic commands against {ip} in your CLI</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
    {tools.map((tool) => (
      <div class="flex items-center justify-between p-3 rounded-xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200/60 dark:border-neutral-800/80">
        <div class="flex flex-col min-w-0 pr-3">
          <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">{tool.name}</span>
          <code class="font-mono text-xs text-blue-600 dark:text-blue-400 truncate mt-0.5 select-all">
            {tool.command}
          </code>
        </div>
        <CopyButton
          text={tool.command}
          label=""
          showIconOnly={true}
          className="p-2 rounded-lg bg-white dark:bg-neutral-700/80 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700 border border-neutral-200 dark:border-neutral-600 shrink-0"
        />
      </div>
    ))}
  </div>
</div>
