---
import type { SanityFaq } from '../types/sanity';
import { generateFAQSchema } from '../utils/seo';

interface Props {
  faqs: SanityFaq[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  title = 'Frequently Asked Questions',
  subtitle = 'Everything you need to know about IP addresses, privacy, and geolocation.',
} = Astro.props;

const faqSchema = generateFAQSchema(
  faqs.map((f) => ({ question: f.question, answer: f.answer }))
);
---

<section class="w-full flex flex-col gap-6">
  {(title || subtitle) && (
    <div class="flex flex-col gap-1.5 text-center max-w-2xl mx-auto">
      {title && <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white">{title}</h2>}
      {subtitle && <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400">{subtitle}</p>}
    </div>
  )}

  <div class="flex flex-col gap-3 max-w-3xl mx-auto w-full">
    {faqs.map((faq, index) => (
      <details
        class="group rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 p-5 transition-all shadow-xs open:ring-1 open:ring-blue-500/30"
        open={index === 0}
      >
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-neutral-900 dark:text-white text-base sm:text-lg focus:outline-none">
          <span>{faq.question}</span>
          <span class="p-1 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="pt-3.5 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed border-t border-neutral-100 dark:border-neutral-800/80 mt-3.5">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
