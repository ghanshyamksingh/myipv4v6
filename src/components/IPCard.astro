---
import type { IPDetails } from '../types/ip';
import CopyButton from './CopyButton.astro';

interface Props {
  details: IPDetails;
  isVisitor?: boolean;
}

const { details, isVisitor = true } = Astro.props;

const isV6 = details.version === 'IPv6';
const shareUrl = `https://myipv4v6.com/ip/${encodeURIComponent(details.ip)}`;

// Prepare serialized JSON and Markdown for one-click developer export
const jsonExport = JSON.stringify(details, null, 2);
const exportLocation =
  details.source === 'fallback' && !details.isPrivate
    ? 'Location data temporarily unavailable'
    : [details.city, details.region, details.country].filter(Boolean).join(', ') || 'Unknown';
const exportIsp =
  details.isp && details.isp !== 'Unknown Provider'
    ? details.isp
    : details.asOrganization && details.asOrganization !== 'Unknown Organization'
    ? details.asOrganization
    : 'Unavailable';

const mdExport = [
  `### Network Report: ${details.ip}`,
  `- **Protocol:** ${details.version}`,
  `- **Location:** ${exportLocation}`,
  `- **ISP:** ${exportIsp}`,
  `- **ASN:** ${details.asn || 'N/A'}`,
  `- **Reverse DNS:** ${details.hostname || 'None'}`,
  `- **Coordinates:** ${details.latitude ?? 'N/A'}, ${details.longitude ?? 'N/A'}`,
  `- **Reported By:** myipv4v6.com`,
].join('\n');
---

<div class={`relative overflow-hidden rounded-3xl bg-white dark:bg-neutral-900 border ${
  isVisitor 
    ? 'border-blue-200/80 dark:border-blue-900/60 shadow-xl shadow-blue-500/5' 
    : 'border-neutral-200/80 dark:border-neutral-800 shadow-xl shadow-neutral-200/40 dark:shadow-black/40'
} transition-all p-6 sm:p-8 md:p-10`}>
  <!-- Subtle background glow -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-500/10 dark:bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-indigo-500/10 dark:bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col gap-6">
    <!-- Top badge row -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
          isV6
            ? 'bg-purple-100 text-purple-700 dark:bg-purple-950/70 dark:text-purple-300 border border-purple-200 dark:border-purple-800'
            : 'bg-blue-100 text-blue-700 dark:bg-blue-950/70 dark:text-blue-300 border border-blue-200 dark:border-blue-800'
        }`}>
          {details.version}
        </span>

        {details.isPrivate ? (
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
            Private Subnet
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            {isVisitor ? 'Your Active Public IP' : 'Queried Target IP'}
          </span>
        )}

        {isVisitor ? (
          <span class="text-xs text-blue-600 dark:text-blue-400 font-medium hidden sm:inline-block bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded-md">
            Visitor Session
          </span>
        ) : (
          <a href="/" class="text-xs text-neutral-500 hover:text-blue-600 dark:text-neutral-400 dark:hover:text-blue-400 font-medium hidden sm:inline-flex items-center gap-1">
            <span>← Check My IP</span>
          </a>
        )}
      </div>

      <!-- Edge status badge -->
      <div class="flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400">
        <svg class="w-3.5 h-3.5 text-blue-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>
          {details.source === 'cloudflare'
            ? 'Cloudflare Edge Verified'
            : details.source === 'cache'
            ? 'Edge Cached (24h)'
            : details.source === 'ipwhois'
            ? 'Enriched via ipwho.is'
            : details.source === 'ipinfo'
            ? 'Enriched via ipinfo.io'
            : details.source === 'ip-api'
            ? 'Enriched via ip-api pro'
            : details.isPrivate
            ? 'Private Subnet'
            : 'Provider Temporarily Unavailable'}
        </span>
      </div>
    </div>

    <!-- Main IP Display -->
    <div class="flex flex-col gap-1.5">
      <span class="text-xs font-semibold tracking-wider uppercase text-neutral-400 dark:text-neutral-500">
        {isVisitor ? 'Your Public IP Address' : 'Queried IP Lookup Report'}
      </span>
      <div class="font-mono text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-neutral-900 dark:text-white break-all select-all">
        {details.ip}
      </div>
    </div>

    <!-- True Dual-Stack Detection Banner (Visitor Homepage Only) -->
    {isVisitor && (
      <div id="dual-stack-card" class="rounded-2xl bg-neutral-50 dark:bg-neutral-850/60 border border-neutral-200/70 dark:border-neutral-800 p-4 transition-all">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span id="ds-indicator" class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
            <div class="flex flex-col">
              <span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">
                Dual-Stack IPv4 / IPv6 Companion Check
              </span>
              <span id="ds-status-text" class="text-xs text-neutral-500 dark:text-neutral-400">
                Probing network for your {isV6 ? 'IPv4' : 'IPv6'} address...
              </span>
            </div>
          </div>

          <div id="ds-companion-box" class="hidden items-center gap-2 font-mono text-xs">
            <span id="ds-companion-badge" class="px-2 py-0.5 rounded text-[11px] font-bold bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-neutral-200"></span>
            <a id="ds-companion-link" href="#" class="font-bold text-blue-600 dark:text-blue-400 hover:underline select-all"></a>
            <button
              type="button"
              id="ds-copy-btn"
              class="p-1.5 rounded-lg bg-neutral-200/70 dark:bg-neutral-700 hover:bg-neutral-300 dark:hover:bg-neutral-600 text-neutral-700 dark:text-neutral-200 transition-colors"
              title="Copy companion IP"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    )}

    <!-- Quick Location & ISP Banner -->
    <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 pt-2 border-t border-neutral-100 dark:border-neutral-800">
      <div class="inline-flex items-center gap-2 font-medium">
        <span class="text-2xl" role="img" aria-label={details.country}>{details.flagEmoji || '🌐'}</span>
        <span>
          {details.source === 'fallback' && !details.isPrivate
            ? 'Location data temporarily unavailable'
            : [details.city, details.region, details.country].filter((v) => Boolean(v) && v !== 'Unknown' && v !== 'Network query failed').join(', ') || 'Location details unavailable'}
        </span>
      </div>

      {((details.isp && details.isp !== 'Unknown Provider') || (details.asOrganization && details.asOrganization !== 'Unknown Organization')) && (
        <>
          <span class="hidden sm:inline text-neutral-300 dark:text-neutral-700">•</span>
          <div class="inline-flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400">
            <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span class="font-semibold text-neutral-800 dark:text-neutral-200">
              {details.isp && details.isp !== 'Unknown Provider' ? details.isp : details.asOrganization}
            </span>
            {details.asn && (
              <span class="font-mono text-xs px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 font-normal">
                {details.asn}
              </span>
            )}
          </div>
        </>
      )}
    </div>

    <!-- Action Buttons Row -->
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-4 border-t border-neutral-100 dark:border-neutral-800">
      <CopyButton
        text={details.ip}
        label="Copy IP"
        copiedLabel="IP Copied!"
        className="px-5 py-3 text-sm font-semibold rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-100 shadow-md transition-all active:scale-95"
      />

      <!-- One-Click Export Dropdown / Popover -->
      <div class="relative inline-block text-left" id="export-dropdown-container">
        <button
          type="button"
          id="export-menu-btn"
          aria-haspopup="true"
          aria-expanded="false"
          class="inline-flex items-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl bg-neutral-100 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Export</span>
          <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="export-menu"
          class="hidden absolute left-0 sm:left-auto sm:right-0 mt-2 w-48 rounded-2xl bg-white dark:bg-neutral-850 border border-neutral-200 dark:border-neutral-750 shadow-xl py-1.5 z-50 text-xs font-medium text-neutral-700 dark:text-neutral-200"
        >
          <button
            type="button"
            id="copy-json-btn"
            data-json={jsonExport}
            class="w-full text-left px-4 py-2.5 hover:bg-neutral-100 dark:hover:bg-neutral-800 flex items-center gap-2 transition-colors cursor-pointer"
          >
            <span class="font-mono text-blue-600 dark:text-blue-400 font-bold">{'{ }'}</span>
            <span class="export-json-label">Copy JSON Report</span>
          </button>

          <button
            type="button"
            id="copy-md-btn"
            data-md={mdExport}
            class="w-full text-left px-4 py-2.5 hover:bg-neutral-100 dark:hover:bg-neutral-800 flex items-center gap-2 transition-colors cursor-pointer"
          >
            <span class="font-bold text-neutral-500">M↓</span>
            <span class="export-md-label">Copy Markdown Report</span>
          </button>
        </div>
      </div>

      <button
        type="button"
        id="share-ip-btn"
        data-share-url={shareUrl}
        data-share-title={`IP Address: ${details.ip}`}
        data-share-text={`Check network details for ${details.ip} on myipv4v6.com`}
        class="inline-flex items-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl bg-neutral-100 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span class="share-btn-text">Share</span>
      </button>

      <a
        href={`/api/ip?q=${encodeURIComponent(details.ip)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-3 text-sm font-medium rounded-xl text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors ml-auto sm:ml-0"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <span>JSON API</span>
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ isVisitor, currentVersion: details.version, currentIP: details.ip }}>
  (function () {
    // 1. Share button handling
    const shareBtn = document.getElementById('share-ip-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const shareUrl = shareBtn.getAttribute('data-share-url') || window.location.href;
        const shareTitle = shareBtn.getAttribute('data-share-title') || document.title;
        const shareText = shareBtn.getAttribute('data-share-text') || '';
        const textSpan = shareBtn.querySelector('.share-btn-text');

        if (navigator.share) {
          try {
            await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
          } catch {
            // User dismissed
          }
        } else {
          try {
            await navigator.clipboard.writeText(shareUrl);
            if (textSpan) textSpan.textContent = 'Link Copied!';
            setTimeout(() => {
              if (textSpan) textSpan.textContent = 'Share';
            }, 2000);
          } catch {}
        }
      });
    }

    // 2. Export Dropdown Handling
    const exportBtn = document.getElementById('export-menu-btn');
    const exportMenu = document.getElementById('export-menu');
    if (exportBtn && exportMenu) {
      exportBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = exportMenu.classList.contains('hidden');
        exportMenu.classList.toggle('hidden');
        exportBtn.setAttribute('aria-expanded', String(isHidden));
      });

      document.addEventListener('click', () => {
        if (!exportMenu.classList.contains('hidden')) {
          exportMenu.classList.add('hidden');
          exportBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Copy JSON
      const jsonBtn = document.getElementById('copy-json-btn');
      if (jsonBtn) {
        jsonBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const jsonText = jsonBtn.getAttribute('data-json') || '';
          const label = jsonBtn.querySelector('.export-json-label');
          try {
            await navigator.clipboard.writeText(jsonText);
            if (label) label.textContent = 'JSON Copied!';
            setTimeout(() => {
              if (label) label.textContent = 'Copy JSON Report';
              exportMenu.classList.add('hidden');
            }, 1500);
          } catch {}
        });
      }

      // Copy Markdown
      const mdBtn = document.getElementById('copy-md-btn');
      if (mdBtn) {
        mdBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const mdText = mdBtn.getAttribute('data-md') || '';
          const label = mdBtn.querySelector('.export-md-label');
          try {
            await navigator.clipboard.writeText(mdText);
            if (label) label.textContent = 'Markdown Copied!';
            setTimeout(() => {
              if (label) label.textContent = 'Copy Markdown Report';
              exportMenu.classList.add('hidden');
            }, 1500);
          } catch {}
        });
      }
    }

    // 3. Client-Side Dual-Stack Companion Detection (for Visitor on Homepage)
    if (isVisitor) {
      const probeTarget = currentVersion === 'IPv6' ? 'IPv4' : 'IPv6';
      const probeUrl =
        probeTarget === 'IPv4'
          ? 'https://ipv4.icanhazip.com'
          : 'https://ipv6.icanhazip.com';

      const indicator = document.getElementById('ds-indicator');
      const statusText = document.getElementById('ds-status-text');
      const companionBox = document.getElementById('ds-companion-box');
      const companionBadge = document.getElementById('ds-companion-badge');
      const companionLink = document.getElementById('ds-companion-link');
      const companionCopyBtn = document.getElementById('ds-copy-btn');

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 2600);

      fetch(probeUrl, {
        signal: controller.signal,
        cache: 'no-store',
      })
        .then((res) => {
          if (!res.ok) throw new Error('Probe response error');
          return res.text();
        })
        .then((text) => {
          clearTimeout(timeoutId);
          const companionIP = text.trim();
          if (companionIP && companionIP !== currentIP) {
            if (indicator) {
              indicator.classList.remove('bg-blue-500', 'animate-pulse');
              indicator.classList.add('bg-emerald-500');
            }
            if (statusText) {
              statusText.textContent = `Dual-Stack active: Both IPv4 and IPv6 detected on your network connection.`;
            }
            if (companionBox && companionBadge && companionLink) {
              companionBadge.textContent = probeTarget;
              companionLink.textContent = companionIP;
              companionLink.href = `/ip/${encodeURIComponent(companionIP)}`;
              companionBox.classList.remove('hidden');
              companionBox.classList.add('flex');
            }

            if (companionCopyBtn) {
              companionCopyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(companionIP);
                companionCopyBtn.classList.add('text-emerald-500');
                setTimeout(() => companionCopyBtn.classList.remove('text-emerald-500'), 1500);
              });
            }
          } else {
            throw new Error('No separate companion IP');
          }
        })
        .catch(() => {
          clearTimeout(timeoutId);
          if (indicator) {
            indicator.classList.remove('bg-blue-500', 'animate-pulse');
            indicator.classList.add('bg-neutral-400');
          }
          if (statusText) {
            statusText.textContent =
              probeTarget === 'IPv6'
                ? 'IPv6 not detected on current network (ISP or router operating on IPv4-only).'
                : 'IPv4 companion address not detected (IPv6-only connection).';
          }
        });
    }
  })();
</script>
