---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  noIndex,
  schema,
  type,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      noIndex={noIndex}
      schema={schema}
      type={type}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50/70 text-neutral-900 dark:bg-[#0a0a0c] dark:text-neutral-100 font-sans transition-colors duration-150">
    <Header />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
